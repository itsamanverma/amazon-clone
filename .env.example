# Amazon Clone Environment Variables

# ===== GEMINI AI CONFIGURATION =====
# Get your API key from: https://makersuite.google.com/app/apikey
REACT_APP_GEMINI_API_KEY=your_gemini_api_key_here

# ===== STRIPE CONFIGURATION =====
# Get your keys from: https://dashboard.stripe.com/apikeys
REACT_APP_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# ===== FIREBASE CONFIGURATION =====
# Get your config from: https://console.firebase.google.com/
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=123456789
REACT_APP_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# ===== DEVELOPMENT SETTINGS =====
GENERATE_SOURCEMAP=false
REACT_APP_ENV=development

# ===== IMAGE OPTIMIZATION =====
REACT_APP_IMAGE_QUALITY=90
REACT_APP_IMAGE_LAZY_LOAD=true
REACT_APP_WEBP_ENABLED=true

# ===== GEMINI IMAGE GENERATION =====
REACT_APP_GEMINI_IMAGE_WIDTH=600
REACT_APP_GEMINI_IMAGE_HEIGHT=400
REACT_APP_GEMINI_IMAGE_QUALITY=90
REACT_APP_GEMINI_FEATURED_WIDTH=800
REACT_APP_GEMINI_FEATURED_HEIGHT=600